# Database — PostgreSQL (required)
# For local dev: start the db container with `docker compose up db`, then use the URL below.
# For production: replace with your production PostgreSQL connection string.
# Note: PostgreSQL is exposed on non-default port 54713 (not 5432) to reduce automated scanner noise.
DATABASE_URL="postgresql://flatrate:flatrate_password@localhost:54713/rateyourflat"

# NextAuth
NEXTAUTH_SECRET="min-32-chars-secret-key-here-generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) - Optional
# RESEND_API_KEY="re_..."

# Upload
# UPLOAD_DIR="/app/public/uploads"
# MAX_FILE_SIZE=5242880
